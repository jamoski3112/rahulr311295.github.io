---
import Base from '../layouts/Base.astro';
---
<Base title="Search" description="Search every post on rahulr.in." noindex>
  <link slot="head" rel="stylesheet" href="/pagefind/pagefind-ui.css" />
  <div class="container narrow">
    <header class="page-head">
      <p class="eyebrow">grep -ri</p>
      <h1>Search</h1>
      <p>Full-text search across every writeup. Index is built at deploy time by Pagefind.</p>
    </header>
    <div id="search"></div>
    <p class="hint mono" id="search-hint" hidden>Search index not found — run <code>npm run build</code> and <code>npm run preview</code>; search is unavailable in <code>astro dev</code>.</p>
  </div>
</Base>

<script is:inline>
  window.addEventListener('DOMContentLoaded', () => {
    const s = document.createElement('script');
    s.src = '/pagefind/pagefind-ui.js';
    s.onload = () => {
      new PagefindUI({ element: '#search', showSubResults: true, showImages: false, autofocus: true });
      const q = new URLSearchParams(location.search).get('q');
      if (q) {
        const input = document.querySelector('#search input');
        if (input) { input.value = q; input.dispatchEvent(new Event('input', { bubbles: true })); }
      }
    };
    s.onerror = () => { document.getElementById('search-hint').hidden = false; };
    document.head.appendChild(s);
  });
</script>

<style is:global>
  .narrow { max-width: 820px; }
  .hint { color: var(--warn); font-size: 0.85rem; }
  :root {
    --pagefind-ui-scale: 0.95;
    --pagefind-ui-primary: var(--accent);
    --pagefind-ui-text: var(--text);
    --pagefind-ui-background: var(--surface);
    --pagefind-ui-border: var(--border-strong);
    --pagefind-ui-tag: var(--surface-2);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 8px;
    --pagefind-ui-font: var(--font-sans);
  }
  .pagefind-ui__search-input { font-family: var(--font-mono) !important; }
  .pagefind-ui__result-link { color: var(--accent) !important; }
  .pagefind-ui__result-title { font-weight: 600; }
  .pagefind-ui__result-excerpt mark { background: rgba(22,200,209,.25); color: var(--text-strong); border-radius: 3px; padding: 0 2px; }
  .pagefind-ui__message, .pagefind-ui__result-excerpt { color: var(--muted) !important; }
  .pagefind-ui__button { background: var(--surface) !important; color: var(--text) !important; border-color: var(--border-strong) !important; }
</style>
