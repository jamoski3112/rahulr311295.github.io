---
import Base from './Base.astro';
import Icon from '../components/Icon.astro';
import type { Taxonomy } from '../lib/posts';
interface Props { kind: 'categories' | 'tags'; items: Taxonomy[] }
const { kind, items } = Astro.props;
const label = kind === 'categories' ? 'Categories' : 'Tags';
const icon = kind === 'categories' ? 'folder' : 'tag';
---
<Base title={label} description={`Browse posts on rahulr.in by ${kind}.`}>
  <div class="container">
    <header class="page-head">
      <p class="eyebrow">{kind}</p>
      <h1>{label}</h1>
      <p>{items.length} {kind}. Click one to see its posts.</p>
    </header>
    <ul class="cloud">
      {items.map((t) => (
        <li>
          <a href={`/${kind}/${t.slug}/`} class="chip" style={`--w:${Math.min(1, 0.55 + t.posts.length / 8)}`}>
            <Icon name={icon} size={13} />
            <span class="chip__name">{t.name}</span>
            <span class="chip__count mono">{t.posts.length}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</Base>

<style>
  .cloud {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    padding: 0.55em 1em;
    border-radius: 8px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text);
    font-size: calc(0.8rem + 0.35rem * var(--w));
    transition: all 0.15s;
  }
  .chip svg {
    color: var(--accent);
  }
  .chip:hover {
    border-color: var(--accent);
    color: var(--text-strong);
    box-shadow: 0 0 0 3px var(--accent-dim);
  }
  .chip__count {
    font-size: 0.72rem;
    color: var(--muted);
    padding: 0.05em 0.5em;
    border-radius: 999px;
    background: var(--surface-2);
  }
</style>
