---
import type { MarkdownHeading } from 'astro';
interface Props { headings: MarkdownHeading[] }
const headings = Astro.props.headings.filter((h) => h.depth >= 1 && h.depth <= 3);
const min = Math.min(...headings.map((h) => h.depth));
---
{headings.length > 1 && (
  <nav class="toc" aria-label="Table of contents">
    <p class="toc__title eyebrow">contents</p>
    <ul>
      {headings.map((h) => (
        <li class={`d${h.depth - min}`}><a href={`#${h.slug}`} data-toc={h.slug}>{h.text}</a></li>
      ))}
    </ul>
  </nav>
)}

<style>
  .toc {
    font-size: 0.83rem;
  }
  .toc__title {
    margin: 0 0 0.6rem;
  }
  .toc ul {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 1px solid var(--border);
    max-height: calc(100vh - 160px);
    overflow-y: auto;
  }
  .toc li a {
    display: block;
    padding: 0.28rem 0.8rem;
    margin-left: -1px;
    border-left: 2px solid transparent;
    color: var(--muted);
    line-height: 1.4;
  }
  .toc li.d1 a { padding-left: 1.6rem; }
  .toc li.d2 a { padding-left: 2.4rem; font-size: 0.78rem; }
  .toc li a:hover {
    color: var(--text-strong);
  }
  .toc li a.active {
    color: var(--accent);
    border-left-color: var(--accent);
  }
</style>
