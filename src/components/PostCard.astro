---
import type { Post } from '../lib/posts';
import { postUrl, fmtDate, isoDate, readingTime, slugify } from '../lib/posts';
import Icon from './Icon.astro';

interface Props { post: Post; featured?: boolean }
const { post, featured = false } = Astro.props;
const { title, description, date, teaser, categories, tags, htb } = post.data;
const url = postUrl(post);
const category = categories[0];
const mins = readingTime(post.body);
const osIcon = htb?.os ? `/assets/images/icons/os-${htb.os.toLowerCase()}.webp` : null;
---
<article class:list={['card', { 'card--featured': featured, 'card--htb': !!htb }]}>
  <a class="card__media" href={url} tabindex="-1" aria-hidden="true">
    {teaser ? (
      <img src={teaser} alt="" loading="lazy" decoding="async" width="640" height="360" />
    ) : (
      <div class="card__placeholder mono">&gt;_</div>
    )}
    {htb?.difficulty && <span class:list={['badge', `badge--${htb.difficulty.toLowerCase()}`, 'card__badge']}>{htb.difficulty}</span>}
    {osIcon && <img class="card__os" src={osIcon} alt={htb?.os} title={htb?.os} width="22" height="22" loading="lazy" />}
  </a>
  <div class="card__body">
    <div class="card__meta">
      {category && <a class="card__cat" href={`/categories/${slugify(category)}/`}>{category}</a>}
      <span class="card__dot">•</span>
      <time datetime={isoDate(date)}>{fmtDate(date)}</time>
      <span class="card__dot">•</span>
      <span>{mins} min</span>
    </div>
    <h3 class="card__title"><a href={url}>{title}</a></h3>
    {description && <p class="card__desc">{description}</p>}
    {tags.length > 0 && (
      <ul class="card__tags">
        {tags.slice(0, 4).map((t) => (
          <li><a class="pill" href={`/tags/${slugify(t)}/`}><Icon name="tag" size={11} />{t}</a></li>
        ))}
      </ul>
    )}
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .card:hover {
    transform: translateY(-3px);
    border-color: rgba(22, 200, 209, 0.5);
    box-shadow: var(--shadow), 0 0 0 1px rgba(22, 200, 209, 0.15);
  }
  /* fixed-size thumbnail regardless of source resolution */
  .card__media {
    position: relative;
    display: block;
    width: 100%;
    height: 180px;
    flex: 0 0 180px;
    background: var(--bg-elev);
    border-bottom: 1px solid var(--border);
    overflow: hidden;
  }
  .card__media img:not(.card__os) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 0.3s ease;
  }
  .card--htb .card__media img:not(.card__os) {
    object-fit: contain;
    padding: 18px;
    background:
      radial-gradient(circle at 50% 50%, rgba(22, 200, 209, 0.12), transparent 65%),
      var(--bg-elev);
  }
  .card:hover .card__media img:not(.card__os) {
    transform: scale(1.04);
  }
  .card__placeholder {
    height: 100%;
    display: grid;
    place-items: center;
    font-size: 2.2rem;
    color: var(--accent);
    opacity: 0.6;
  }
  .card__badge {
    position: absolute;
    top: 10px;
    right: 10px;
    backdrop-filter: blur(6px);
  }
  .card__os {
    position: absolute;
    top: 10px;
    left: 10px;
    width: 22px;
    height: 22px;
    object-fit: contain;
    border-radius: 4px;
    background: rgba(10, 13, 18, 0.8);
    padding: 2px;
  }
  .card__body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1rem 1.1rem 1.1rem;
    flex: 1;
  }
  .card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45em;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--muted);
  }
  .card__cat {
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .card__dot {
    opacity: 0.5;
  }
  .card__title {
    font-size: 1.08rem;
    margin: 0;
    line-height: 1.35;
  }
  .card__title a {
    color: var(--text-strong);
  }
  .card__title a:hover {
    color: var(--accent);
  }
  .card__desc {
    margin: 0;
    color: var(--muted);
    font-size: 0.9rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .card__tags {
    list-style: none;
    margin: auto 0 0;
    padding: 0.35rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
  .card--featured {
    grid-column: 1 / -1;
  }
  @media (min-width: 760px) {
    .card--featured {
      flex-direction: row;
    }
    .card--featured .card__media {
      width: 46%;
      flex: 0 0 46%;
      height: auto;
      min-height: 280px;
      border-bottom: 0;
      border-right: 1px solid var(--border);
    }
    .card--featured .card__body {
      padding: 1.6rem 1.8rem;
      justify-content: center;
    }
    .card--featured .card__title {
      font-size: 1.5rem;
    }
    .card--featured .card__desc {
      -webkit-line-clamp: 5;
      font-size: 0.98rem;
    }
  }
</style>
